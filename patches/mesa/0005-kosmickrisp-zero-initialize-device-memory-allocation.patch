From d6056e4afdcd43238cfa5f1775990a43e18e4ab3 Mon Sep 17 00:00:00 2001
From: BAR rebase <bar@local>
Date: Thu, 10 Sep 2026 20:02:19 +1000
Subject: [PATCH 5/9] kosmickrisp: zero-initialize device memory allocations

---
 src/kosmickrisp/vulkan/kk_bo.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/kosmickrisp/vulkan/kk_bo.c b/src/kosmickrisp/vulkan/kk_bo.c
index 6926326969e..ed56a7a1518 100644
--- a/src/kosmickrisp/vulkan/kk_bo.c
+++ b/src/kosmickrisp/vulkan/kk_bo.c
@@ -58,6 +58,15 @@ kk_alloc_bo(struct kk_device *dev, struct vk_object_base *log_obj,
    bo->gpu = mtl_buffer_get_gpu_address(map);
    bo->cpu = mtl_get_contents(map);
 
+   /* Fresh MTLHeap storage is recycled VRAM with undefined contents. Zero it
+    * (unified memory: plain CPU memset through the heap-spanning buffer, once
+    * per allocation, before any resource can reference the heap) so
+    * never-rendered resources — e.g. an FBO texture whose render pass failed
+    * or has not run yet — read back as transparent black, matching drivers
+    * that hand out zeroed pages, instead of leftover-VRAM garbage. */
+   if (bo->cpu != NULL)
+      memset(bo->cpu, 0, size_B);
+
    kk_device_add_heap_to_residency_set(dev, handle);
 
    *bo_out = bo;
