From 1a0be0c544af98b4ea2dd92a88f815fd913294f5 Mon Sep 17 00:00:00 2001
From: BAR rebase <bar@local>
Date: Thu, 10 Sep 2026 20:02:18 +1000
Subject: [PATCH 1/9] poly: barrier after reading shared scratch out_ptr in
 unroll

---
 src/poly/cl/restart.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/poly/cl/restart.h b/src/poly/cl/restart.h
index 995720da0ea..b99938d1850 100644
--- a/src/poly/cl/restart.h
+++ b/src/poly/cl/restart.h
@@ -191,6 +191,13 @@ poly_unroll_geometry(global uint32_t *out_draw,
    if (get_num_sub_groups() > 1) {
       barrier(CLK_LOCAL_MEM_FENCE);
       out_ptr = *(uintptr_t *)scratch;
+      /* All lanes must finish reading out_ptr before the restart-search
+       * reduction below reuses the SAME scratch memory: without this barrier a
+       * fast lane can clobber scratch while a slow lane has not yet read it,
+       * and the slow lane then stores indices through a garbage pointer —
+       * a rare, scheduling-dependent wild write corrupting unrelated heap
+       * allocations (manifested as garbage geometry/giant triangles). */
+      barrier(CLK_LOCAL_MEM_FENCE);
    } else {
       out_ptr = sub_group_broadcast(out_ptr, 0);
    }
