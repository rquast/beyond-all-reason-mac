From ca97e555148df8ce35246c2e222a6c8a5aaa931e Mon Sep 17 00:00:00 2001
From: BAR rebase <bar@local>
Date: Thu, 10 Sep 2026 20:02:19 +1000
Subject: [PATCH 8/9] zink: update pipeline on vertex-elements change without
 dynamic VI

---
 src/gallium/drivers/zink/zink_draw.cpp | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/zink/zink_draw.cpp b/src/gallium/drivers/zink/zink_draw.cpp
index 5cdb36e91e2..d4baa29864b 100644
--- a/src/gallium/drivers/zink/zink_draw.cpp
+++ b/src/gallium/drivers/zink/zink_draw.cpp
@@ -695,7 +695,18 @@ zink_draw(struct pipe_context *pctx,
    if (have_streamout && ctx->dirty_so_targets)
       zink_emit_stream_output_targets(pctx);
 
-   bool pipeline_changed = ctx->gfx_pipeline_state.dirty || rp_state != ctx->gfx_pipeline_state.rp_state || ctx->gfx_dirty || ctx->dirty_gfx_stages || prim_changed || BATCH_CHANGED ?
+   /* without VK_EXT_vertex_input_dynamic_state the vertex-elements state (formats,
+    * offsets, and possibly strides) is baked into the pipeline, so a vertex-elements
+    * change alone must also trigger a pipeline update: zink_get_gfx_pipeline handles
+    * ctx->vertex_state_changed (vertex_hash recalc), but only if it actually runs.
+    * otherwise a draw that changes only the vertex layout (e.g. vbo-exec flushes with
+    * different vertex sizes) reuses the previous pipeline and reads the new buffer
+    * with the old format/stride.
+    */
+   bool vertex_pipeline_changed = DYNAMIC_STATE != ZINK_DYNAMIC_VERTEX_INPUT2 &&
+                                  DYNAMIC_STATE != ZINK_DYNAMIC_VERTEX_INPUT &&
+                                  ctx->vertex_state_changed;
+   bool pipeline_changed = ctx->gfx_pipeline_state.dirty || rp_state != ctx->gfx_pipeline_state.rp_state || ctx->gfx_dirty || ctx->dirty_gfx_stages || prim_changed || vertex_pipeline_changed || BATCH_CHANGED ?
                            update_gfx_pipeline<DYNAMIC_STATE, BATCH_CHANGED>(ctx, bs, mode) :
                            false;
 
