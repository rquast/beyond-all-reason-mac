From 84644b53467781e7b37e183deb14d063a9f79794 Mon Sep 17 00:00:00 2001
From: BAR rebase <bar@local>
Date: Thu, 10 Sep 2026 20:02:19 +1000
Subject: [PATCH 7/9] zink: do not clear vertex_buffers_dirty on empty/unbind
 (re-based: consume-site moved to zink_context.c)

---
 src/gallium/drivers/zink/zink_context.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/gallium/drivers/zink/zink_context.c b/src/gallium/drivers/zink/zink_context.c
index e17815079ec..7c1aa363cbb 100644
--- a/src/gallium/drivers/zink/zink_context.c
+++ b/src/gallium/drivers/zink/zink_context.c
@@ -1444,7 +1444,8 @@ zink_bind_vertex_elements_state(struct pipe_context *pctx,
    if (cso) {
       if (state->element_state != &ctx->element_state->hw_state) {
          ctx->vertex_state_changed = true;
-         ctx->vertex_buffers_dirty = ctx->element_state->hw_state.num_bindings > 0;
+         if (ctx->element_state->hw_state.num_bindings > 0)
+            ctx->vertex_buffers_dirty = true;
       }
       state->element_state = &ctx->element_state->hw_state;
       if (zink_screen(pctx->screen)->optimal_keys)
@@ -1547,7 +1548,10 @@ zink_set_vertex_buffers_internal(struct pipe_context *pctx,
    /* avoid potential overdraw conflicts */
    ctx->can_promote_depth_op = false;
    ctx->vertex_buffers_count = num_buffers;
-   ctx->vertex_buffers_dirty = num_buffers > 0;
+   /* never CLEAR pending dirtiness on an unbind: a queued rebind must survive
+    * until a draw with actual bindings consumes it */
+   if (num_buffers > 0)
+      ctx->vertex_buffers_dirty = true;
 }
 
 static void
@@ -1597,7 +1601,11 @@ zink_bind_vertex_buffers_internal(struct zink_context *ctx, const struct pipe_ve
                                   elems->hw_state.num_bindings,
                                   buffers, buffer_offsets, NULL, NULL);
 
-   ctx->vertex_buffers_dirty = false;
+   /* only consume the dirty flag when bindings were actually emitted: an empty
+    * vertex-elements state emits nothing, and clearing here would drop a still-
+    * pending rebind for the next draw that does have bindings */
+   if (elems->hw_state.num_bindings)
+      ctx->vertex_buffers_dirty = false;
 }
 
 void
