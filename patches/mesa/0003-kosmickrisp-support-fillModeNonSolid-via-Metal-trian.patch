From 318320da83e95c10ae8b0b03176573b6466ea0ac Mon Sep 17 00:00:00 2001
From: BAR rebase <bar@local>
Date: Thu, 10 Sep 2026 20:02:19 +1000
Subject: [PATCH 3/9] kosmickrisp: support fillModeNonSolid via Metal triangle
 fill mode

---
 src/kosmickrisp/bridge/mtl_encoder.h        |  3 +++
 src/kosmickrisp/bridge/mtl_encoder.m        | 10 ++++++++++
 src/kosmickrisp/bridge/mtl_types.h          |  5 +++++
 src/kosmickrisp/bridge/stubs/mtl_encoder.c  |  6 ++++++
 src/kosmickrisp/vulkan/kk_cmd_draw.c        | 10 ++++++++++
 src/kosmickrisp/vulkan/kk_physical_device.c |  1 +
 6 files changed, 35 insertions(+)

diff --git a/src/kosmickrisp/bridge/mtl_encoder.h b/src/kosmickrisp/bridge/mtl_encoder.h
index 91ef3af0e18..75ecaa1cd75 100644
--- a/src/kosmickrisp/bridge/mtl_encoder.h
+++ b/src/kosmickrisp/bridge/mtl_encoder.h
@@ -88,6 +88,9 @@ void mtl_set_front_face_winding(mtl_render_encoder *encoder,
 
 void mtl_set_cull_mode(mtl_render_encoder *encoder, enum mtl_cull_mode mode);
 
+void mtl_set_triangle_fill_mode(mtl_render_encoder *encoder,
+                                enum mtl_triangle_fill_mode mode);
+
 void mtl_set_visibility_result_mode(mtl_render_encoder *encoder,
                                     enum mtl_visibility_result_mode mode,
                                     size_t offset);
diff --git a/src/kosmickrisp/bridge/mtl_encoder.m b/src/kosmickrisp/bridge/mtl_encoder.m
index 433cced8427..ca60d337d35 100644
--- a/src/kosmickrisp/bridge/mtl_encoder.m
+++ b/src/kosmickrisp/bridge/mtl_encoder.m
@@ -315,6 +315,16 @@
    }
 }
 
+void
+mtl_set_triangle_fill_mode(mtl_render_encoder *encoder,
+                           enum mtl_triangle_fill_mode mode)
+{
+   @autoreleasepool {
+      id<MTLRenderCommandEncoder> enc = (id<MTLRenderCommandEncoder>)encoder;
+      [enc setTriangleFillMode:(MTLTriangleFillMode)mode];
+   }
+}
+
 void
 mtl_set_visibility_result_mode(mtl_render_encoder *encoder,
                                enum mtl_visibility_result_mode mode,
diff --git a/src/kosmickrisp/bridge/mtl_types.h b/src/kosmickrisp/bridge/mtl_types.h
index 76256c2f86a..b61090b43be 100644
--- a/src/kosmickrisp/bridge/mtl_types.h
+++ b/src/kosmickrisp/bridge/mtl_types.h
@@ -218,6 +218,11 @@ enum mtl_cull_mode {
    MTL_CULL_MODE_BACK = 2,
 };
 
+enum mtl_triangle_fill_mode {
+   MTL_TRIANGLE_FILL_MODE_FILL = 0,
+   MTL_TRIANGLE_FILL_MODE_LINES = 1,
+};
+
 enum mtl_visibility_result_mode {
    MTL_VISIBILITY_RESULT_MODE_DISABLED = 0,
    MTL_VISIBILITY_RESULT_MODE_BOOLEAN = 1,
diff --git a/src/kosmickrisp/bridge/stubs/mtl_encoder.c b/src/kosmickrisp/bridge/stubs/mtl_encoder.c
index b1482b50b4d..85011448c89 100644
--- a/src/kosmickrisp/bridge/stubs/mtl_encoder.c
+++ b/src/kosmickrisp/bridge/stubs/mtl_encoder.c
@@ -153,6 +153,12 @@ mtl_set_cull_mode(mtl_render_encoder *encoder, enum mtl_cull_mode mode)
 {
 }
 
+void
+mtl_set_triangle_fill_mode(mtl_render_encoder *encoder,
+                           enum mtl_triangle_fill_mode mode)
+{
+}
+
 void
 mtl_set_visibility_result_mode(mtl_render_encoder *encoder,
                                enum mtl_visibility_result_mode mode,
diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 14072e3a1b4..44af611341e 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1228,6 +1228,16 @@ kk_flush_dynamic_state(struct kk_cmd_buffer *cmd)
       }
    }
 
+   if (IS_DIRTY(RS_POLYGON_MODE)) {
+      /* Metal has no point fill mode; VK_POLYGON_MODE_POINT is never emitted
+       * by our users (zink forces FILL when maint5 polygonModePointSize is
+       * unsupported), so map every non-fill mode to lines. */
+      mtl_set_triangle_fill_mode(enc,
+                                 dyn->rs.polygon_mode == VK_POLYGON_MODE_FILL
+                                    ? MTL_TRIANGLE_FILL_MODE_FILL
+                                    : MTL_TRIANGLE_FILL_MODE_LINES);
+   }
+
    /* We enable raster discard by setting scissor to size (0, 0) */
    if (!(dyn->rs.rasterizer_discard_enable || gfx->is_cull_front_and_back) &&
        (IS_DIRTY(VP_VIEWPORT_COUNT) || IS_DIRTY(VP_VIEWPORTS) ||
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 227273d1326..66c44701b1b 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -211,6 +211,7 @@ kk_get_device_features(
       .depthClamp = true,
       .drawIndirectFirstInstance = true,
       .dualSrcBlend = true,
+      .fillModeNonSolid = true,
       .fragmentStoresAndAtomics = true,
       .fullDrawIndexUint32 = true,
       .imageCubeArray = true,
-- 
